{
  "name": "Hola Mundo Test",
  "uuid": "00000000-0000-0000-0000-000000000001",
  "spec_version": "13.1.0",
  "language": "spa",
  "type": "messaging",
  "nodes": [
    {
      "uuid": "node-inicio",
      "actions": [
        {
          "attachments": [],
          "text": "👋 ¡Hola Mundo!\n\n¿Cómo te sientes hoy?",
          "type": "send_msg",
          "quick_replies": [
            "😊 Bien",
            "😐 Normal",
            "😢 Mal"
          ],
          "uuid": "action-saludo"
        }
      ],
      "exits": [
        {
          "uuid": "exit-inicio",
          "destination_uuid": "node-respuesta"
        }
      ]
    },
    {
      "uuid": "node-respuesta",
      "router": {
        "type": "switch",
        "default_category_uuid": "cat-other",
        "result_name": "estado_animo",
        "operand": "@input.text",
        "wait": {
          "type": "msg"
        },
        "cases": [
          {
            "uuid": "case-bien",
            "type": "has_any_word",
            "arguments": [
              "bien",
              "😊"
            ],
            "category_uuid": "cat-bien"
          },
          {
            "uuid": "case-normal",
            "type": "has_any_word",
            "arguments": [
              "normal",
              "😐"
            ],
            "category_uuid": "cat-normal"
          },
          {
            "uuid": "case-mal",
            "type": "has_any_word",
            "arguments": [
              "mal",
              "😢"
            ],
            "category_uuid": "cat-mal"
          }
        ],
        "categories": [
          {
            "uuid": "cat-bien",
            "name": "Bien",
            "exit_uuid": "exit-bien"
          },
          {
            "uuid": "cat-normal",
            "name": "Normal",
            "exit_uuid": "exit-normal"
          },
          {
            "uuid": "cat-mal",
            "name": "Mal",
            "exit_uuid": "exit-mal"
          },
          {
            "uuid": "cat-other",
            "name": "Other",
            "exit_uuid": "exit-other"
          }
        ]
      },
      "exits": [
        {
          "uuid": "exit-bien",
          "destination_uuid": "node-mensaje-bien"
        },
        {
          "uuid": "exit-normal",
          "destination_uuid": "node-mensaje-normal"
        },
        {
          "uuid": "exit-mal",
          "destination_uuid": "node-mensaje-mal"
        },
        {
          "uuid": "exit-other",
          "destination_uuid": "node-mensaje-other"
        }
      ]
    },
    {
      "uuid": "node-mensaje-bien",
      "actions": [
        {
          "attachments": [],
          "text": "🎉 ¡Qué bueno que estés bien!\n\n¡Que sigas teniendo un excelente día! 🚀",
          "type": "send_msg",
          "uuid": "action-mensaje-bien"
        }
      ],
      "exits": [
        {
          "uuid": "exit-mensaje-bien"
        }
      ]
    },
    {
      "uuid": "node-mensaje-normal",
      "actions": [
        {
          "attachments": [],
          "text": "👌 Entiendo, un día normal.\n\nEspero que mejore pronto. ¡Ánimo! 💪",
          "type": "send_msg",
          "uuid": "action-mensaje-normal"
        }
      ],
      "exits": [
        {
          "uuid": "exit-mensaje-normal"
        }
      ]
    },
    {
      "uuid": "node-mensaje-mal",
      "actions": [
        {
          "attachments": [],
          "text": "😔 Lamento que estés mal.\n\nRecuerda que mañana es un nuevo día. ¡No te rindas! 💙",
          "type": "send_msg",
          "uuid": "action-mensaje-mal"
        }
      ],
      "exits": [
        {
          "uuid": "exit-mensaje-mal"
        }
      ]
    },
    {
      "uuid": "node-mensaje-other",
      "actions": [
        {
          "attachments": [],
          "text": "🤔 No entendí tu respuesta.\n\nPor favor selecciona una de las opciones o escribe: Bien, Normal o Mal",
          "type": "send_msg",
          "uuid": "action-mensaje-other"
        }
      ],
      "exits": [
        {
          "uuid": "exit-mensaje-other",
          "destination_uuid": "node-inicio"
        }
      ]
    }
  ],
  "_ui": {
    "nodes": {
      "node-inicio": {
        "position": {
          "left": 100,
          "top": 0
        },
        "type": "execute_actions"
      },
      "node-respuesta": {
        "position": {
          "left": 100,
          "top": 200
        },
        "type": "wait_for_response"
      },
      "node-mensaje-bien": {
        "position": {
          "left": 0,
          "top": 400
