          "left": 150,
          "top": 400
        },
        "type": "execute_actions"
      },
      "node-mensaje-mal": {
        "position": {
          "left": 300,
          "top": 400
        },
        "type": "execute_actions"
      },
      "node-mensaje-other": {
        "position": {
          "left": 450,
          "top": 400
        },
        "type": "execute_actions"
      }
    }
  }
